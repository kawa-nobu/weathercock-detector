{
  "name": "weathercock-detector",
  "version": "0.1",
  "manifest_version": 3,
  "description": "Google検索結果に表示されている詐欺サイトほ非表示する",
  "icons" : {
    "256" : "icon.png"
  },
  "host_permissions": ["https://*.gstatic.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["*://www.google.com/*", "*://www.google.co.jp/*"],
      "css": ["hide.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://www.google.com/*", "*://www.google.co.jp/*"],
      "run_at": "document_end",
      "js": ["content.js"]
    }
  ]
}
