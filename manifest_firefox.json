{
  "name": "weathercock-detector",
  "version": "0.1",
  "manifest_version": 2,
  "description": "Google検索結果から詐欺サイトを非表示する",
  "icons": {
    "256": "icon.png"
  },
  "permissions": ["https://*.gstatic.com/*"],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["*://www.google.com/*", "*://www.google.co.jp/*"],
      "css": ["hide.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://www.google.com/*", "*://www.google.co.jp/*"],
      "run_at": "document_end",
      "js": ["content.js"]
    }
  ]
}
